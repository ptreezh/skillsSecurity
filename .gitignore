
# Environment files
.env
.env.local
.env.production
wallets/

# Dependencies
node_modules/

# Build output
dist/

# Python build artifacts (R18: 16 tracked .pyc/__pycache__ leaked into git;
# stale bytecode can shadow behavior and leaks local paths + Python version)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated skill zip artifacts (R18: skills/template-1.0.0.zip was tracked,
# letting a stale release artifact ship inside the skills/ tree)
agentskills-workbuddy-package/skills/*.zip
# skill-packager 的 test-*/test-output-*.zip 同属打包生成物
# （实测内容为 coze-package.bin 之类的产物，非源文件）
tools/skill-packager-universal/*.zip

# Logs
progress.log
*.log

# Claude worktrees and local settings
.claude/

# Runtime upload artifacts (API tests / temp skill files)
uploads/temp/

# Runtime identity store (P2: scrypt-hashed users + sessions; never commit)
server/data/users.json

# Runtime auth session store + audit log (P30: sessions are keyed by sha256(token),
# audit log contains usernames + IPs — must never enter git history)
server/data/sessions.json
server/data/auth.log.jsonl

# Audit agent temp scripts
temp_audit_*.py

# Timestamped local deployment snapshots (canonical: deployments/core-latest.json)
deployments/core-hardhat-*.json
deployments/core-localhost-*.json

# Local scratch from interactive sessions (screenshots, ad-hoc scripts).
# These are generated by manual UI exploration / video pipelines and have no
# review value; keep them out of git so future diffs stay focused.
workbuddy_*.png
capture_screenshots*.py
generate_video*.py
fix_audio.py
check_pages.py
test_edge.*
after_click.png
edge_screenshot.png
*.mp3
VIDEO_OUTPUT/
VIDEO_*
.trae-html-share-packages/
.chainmaker-work/

.playwright-mcp/
