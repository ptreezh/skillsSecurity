# AgentSkills Environment Variables Template
# Copy this file to .env and fill in your values

# ========================
# ChainMaker 链配置（真实提交到私有链 chain1）
# ========================

# cmc 访问方式：容器命令前缀 + cmc 命令（默认经 cmc-debug 容器访问链）
# CHAINMAKER_CONTAINER_CMD=docker exec cmc-debug
# CHAINMAKER_CMC_CMD=docker exec cmc-debug cmc

# 容器内路径（sdk 配置 / 证书 / ABI）
CHAINMAKER_SDK_CONF=/work/sdk_config.yml
CHAINMAKER_CERT_DIR=/work
CHAINMAKER_ABI_DIR=/work

# 宿主机 ABI 目录（可选；设置后跳过容器内 cat，直接读本地文件）
# CHAINMAKER_ABI_LOCAL_DIR=

# 链参数
CHAINMAKER_CHAIN_ID=chain1
CHAINMAKER_ORG_ID=wx-org.chainmaker.org

# 合约地址（AS_SkillRegistry，v2.0.0）
SKILL_REGISTRY_ADDRESS=cf089d4bebcdabd13cd6a27ba6c168acac6bc042

# ========================
# Frontend / Backend API
# ========================

# Frontend calls this base URL for upload/audit/chain APIs
# Use http://localhost:3001 for local dev
VITE_API_URL=http://localhost:3001

# Backend CORS allowed origins (comma separated)
# Example: https://yourname.github.io,https://yourname.github.io/skillsSecurity
CORS_ORIGIN=

# ========================
# Monitoring (Optional)
# ========================

# Telegram Bot for alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gas alert thresholds (Gwei)
GAS_FAST_THRESHOLD=100
GAS_STANDARD_THRESHOLD=50
GAS_SLOW_THRESHOLD=20

# ========================
# Contract Addresses
# ========================

# ChainMaker chain1 上 AS_SkillRegistry 部署地址（见上方 ChainMaker 配置）
# STAKING_MANAGER_ADDRESS / ATTRIBUTION_ADDRESS / GOVERNANCE_TIMELOCK_ADDRESS
# 仅在后续部署其余合约后填写
STAKING_MANAGER_ADDRESS=
ATTRIBUTION_ADDRESS=
GOVERNANCE_TIMELOCK_ADDRESS=